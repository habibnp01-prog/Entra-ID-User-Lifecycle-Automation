# ============================================
# Entra ID User Lifecycle Automation
# Git Ignore Rules
# ============================================

# Logs
Logs/*
!Logs/.gitkeep

# Generated Reports
Reports/*
!Reports/.gitkeep

# Environment-specific Configuration
Config/Config.json
Config/*.local.json
Config/*.secret.json

# Certificates and private keys
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt

# Secrets and tokens
*.secret
*.token
*.credentials
.env
.env.*

# PowerShell backup files
*.ps1.bak
*.ps1.orig

# Temporary files
*.tmp
*.temp
*.bak
~$*

# Operating system files
Thumbs.db
.DS_Store

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Test artifacts
TestResults/
coverage/

# Local development files
*.local.ps1
